# mock (기본, 키 불필요) | anthropic | openai
# 외부 LLM 전송은 계약 확인 후에만 사용할 것
LLM_PROVIDER=mock
# 비우면 프로바이더 기본 모델 사용
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- 임베딩 / RAG 매칭 ----
# local(기본, sentence-transformers, 외부 전송 없음) | openai(나중용, OPENAI_API_KEY 필요)
EMBEDDING_PROVIDER=local
# 비우면 local=intfloat/multilingual-e5-small, openai=text-embedding-3-small
EMBEDDING_MODEL=
# 모델 출력 차원 = vehicles.embedding 차원과 같아야 함
EMBEDDING_DIM=384
# 모델 캐시 위치 (기본 services/llm/.cache/models)
EMBEDDING_CACHE_DIR=
# /match 가 vehicles 를 읽기 전용으로 조회 (쓰기 없음)
DATABASE_URL=postgres://purplemine:purplemine@localhost:5433/purplemine
