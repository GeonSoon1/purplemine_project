# apps/api/.env 로 복사해서 사용 (.env 는 git 제외)
PORT=4000
CORS_ORIGIN=http://localhost:3000

# docker-compose.yml 과 맞춰야 함
DB_USER=purplemine
DB_PASSWORD=purplemine
DB_NAME=purplemine
DB_PORT=5433
DATABASE_URL=postgres://purplemine:purplemine@localhost:5433/purplemine
# true 면 서버 시작 시 마이그레이션 자동 실행 (기본 false, npm run migration:run 사용)
DB_MIGRATIONS_RUN=false

# 대본 원본 저장 위치 (프로젝트 루트 data/scripts, git 제외). 상대경로는 apps/api 기준
SCRIPT_STORAGE_DIR=../../data/scripts

# LLM 서버 (services/llm)
LLM_SERVER_URL=http://localhost:8000
LLM_TIMEOUT_MS=120000
# /embed, /match 는 요청 경로에서 불리므로 짧게
LLM_EMBED_TIMEOUT_MS=30000
LLM_MATCH_TIMEOUT_MS=15000
# 후보 매칭: rag(기본, LLM /match 우선 + 규칙 폴백) | rule(규칙 기반만)
MATCH_MODE=rag
